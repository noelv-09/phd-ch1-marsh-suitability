# =============================================================================
# Scientific data — large / binary / generated outputs
# =============================================================================
# Raw D-Flow FM outputs are NOT version-controlled; track manifests only.
*.nc
*.nc4
*.hdf5
*.h5
*.zarr/
data/raw/
data/derived/*.npy
data/derived/*.npz
data/derived/*.parquet

# Keep small CSV manifests and YAML configs (do not ignore those).

